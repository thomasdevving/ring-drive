# Required for the official simulator / Playground path.
# Paste only the access token value, without "Bearer ". Never share this file.
RING_ACCESS_TOKEN=

# Optional: only if Ring issued a refresh token for your registered app.
RING_REFRESH_TOKEN=
RING_CLIENT_ID=
RING_CLIENT_SECRET=

# Optional signed webhooks. Account ID is checked against GET /v1/users/me.
RING_HMAC_KEY=
RING_ACCOUNT_ID=

# Separate native-client credential. The setup script generates this locally.
RELAY_CLIENT_TOKEN=
# Encryption key for refreshed tokens; generated locally, never bundled.
TOKEN_STORE_KEY=
PORT=8787

# Household data (absence rules, rule runs, incidents). Defaults to Relay/data/household.local.json (Git-ignored).
DATA_FILE=
# 1 enables POST /simulate/observations for clearly labeled synthetic evidence. Off by default.
SIMULATION_ENABLED=0

# Amazon Bedrock incident summaries (optional; without these a deterministic template is used).
# Use an IAM user/role limited to bedrock:InvokeModel. Never commit real values.
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=anthropic.claude-opus-5-5
BEDROCK_TIMEOUT_MS=15000
# 0 disables Bedrock even when credentials are present.
BEDROCK_ENABLED=1

# Outgoing household messages. DRY_RUN lists channels that are recorded but not delivered:
# "all", "none", or a comma list of app,sms. Unset means "sms" (no real SMS unless you opt in).
DRY_RUN=sms
# Real SMS through Amazon SNS requires sns:Publish and an SNS SMS sandbox/origination setup.
SNS_REGION=

# Ring Drive MCP server (mcp/server.mjs) for Alexa+ at home. Generate with: node scripts/setup_mcp.mjs
MCP_PORT=8790
MCP_TIME_ZONE=Europe/Amsterdam
# Static bearer token for local MCP clients (full tool access). At least 24 characters.
MCP_TOKEN=
# OAuth for Alexa+: client registered in the Alexa+ add-on, the consent password, and the public HTTPS URL.
MCP_CLIENT_ID=
MCP_CLIENT_SECRET=
MCP_OWNER_PASSWORD=
MCP_PUBLIC_URL=
MCP_REDIRECT_URIS=
# Extra Host headers accepted by DNS-rebinding protection (for example the tunnel host).
MCP_ALLOWED_HOSTS=
