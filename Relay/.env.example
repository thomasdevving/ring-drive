# Required for the official simulator / Playground path.
# Paste only the access token value, without "Bearer ". Never share this file.
RING_ACCESS_TOKEN=

# Optional: only if Ring issued a refresh token for your registered app.
RING_REFRESH_TOKEN=
RING_CLIENT_ID=
RING_CLIENT_SECRET=

# Optional signed webhooks. Account ID is checked against GET /v1/users/me.
RING_HMAC_KEY=
RING_ACCOUNT_ID=

# Separate native-client credential. The setup script generates this locally.
RELAY_CLIENT_TOKEN=
# Encryption key for refreshed tokens; generated locally, never bundled.
TOKEN_STORE_KEY=
PORT=8787

# Household data (absence rules, rule runs, incidents). Defaults to Relay/data/household.local.json (Git-ignored).
DATA_FILE=
# 1 enables POST /simulate/observations for clearly labeled synthetic evidence. Off by default.
SIMULATION_ENABLED=0
